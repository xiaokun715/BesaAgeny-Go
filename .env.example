# 复制为 .env（已 gitignore）。配置里只出现变量名，不出现密钥本体。

# 模型厂商
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# 基础设施
BESA_POSTGRES_DSN=postgresql://besa:besa@127.0.0.1:5432/besa_agent
BESA_REDIS_URL=redis://127.0.0.1:6379/0
BESA_NATS_URL=nats://127.0.0.1:4222

# 对象存储（大结果 / 产物）。留空则落本地 .tool_out。
BESA_S3_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 工具可访问目录（默认拒绝；不配就是不许访问）
BESA_WORKDIR=.

# 配置环境与日志
BESA_ENV=dev
BESA_LOG_LEVEL=INFO
